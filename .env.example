# ─────────────────────────────────────────────────────────────
# SHINE Gold & Diamonds — environment template
# Copy to .env.local and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Data mode: "mock" runs fully in the browser (localStorage). "api" switches services to the REST API.
NEXT_PUBLIC_DATA_MODE=mock

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Database (phase 2)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shine?schema=public"

# Auth (phase 2) — generate with: openssl rand -base64 32
AUTH_SECRET=
ADMIN_AUTH_SECRET=

# Payments (provider-independent)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Live metal rates provider
METAL_RATES_PROVIDER=manual
METAL_RATES_API_URL=
METAL_RATES_API_KEY=

# Media storage (S3-compatible / CDN)
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
NEXT_PUBLIC_MEDIA_CDN_URL=

# Notifications
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
